# Fresh test installation: access via an SSH tunnel, not a public HTTP listener.
MOSSWARD_TRANSPORT_MODE=local
MOSSWARD_LISTEN=127.0.0.1:8080
MOSSWARD_PUBLIC_ORIGIN=http://localhost:8080
MOSSWARD_DATABASE_FILE=/var/lib/mossward/mossward.db
MOSSWARD_IDENTITY_KEY_FILE=/var/lib/mossward/identity.key
MOSSWARD_ACME_CACHE_DIR=/var/lib/mossward/acme
MOSSWARD_AGENT_PKI_DIR=/var/lib/mossward/agent-pki
MOSSWARD_WEBAUTHN_RP_ID=localhost
MOSSWARD_WEBAUTHN_ORIGINS=http://localhost:8080
